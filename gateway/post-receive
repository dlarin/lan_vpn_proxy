#!/bin/bash
# Хук на сервере: после git push green файлы уже обновлены (receive.denyCurrentBranch=updateInstead),
# здесь перезапускаем то, что затронули изменения. Подключает install-gateway.sh.
unset GIT_DIR
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
export XDG_RUNTIME_DIR=/run/user/$(id -u)

while read -r old new ref; do
    [ "$ref" = refs/heads/master ] || continue
    if [ "$old" = 0000000000000000000000000000000000000000 ]; then
        files=$(git ls-files)
    else
        files=$(git diff --name-only "$old" "$new")
    fi
    has() { grep -qxE "$1" <<< "$files"; }

    if has 'install-gateway\.sh|gateway-watch\.sh|lan-vpn-proxy-(gateway|web)\.service|gateway/.*'; then
        echo "→ файлы шлюза изменились: sudo ./install-gateway.sh"
        sudo -n ./install-gateway.sh || echo "!! не вышло — запустите на сервере: sudo ./install-gateway.sh"
        continue  # установщик сам перезапустил веб-интерфейс и контейнер
    fi
    if has 'gen_config\.py|docker-compose\.yml'; then
        echo "→ пересобираю конфиг Xray и перезапускаю контейнер"
        ./gen_config.py >/dev/null && docker compose up -d --force-recreate
    fi
    if has 'web\.py|gen_config\.py'; then
        echo "→ перезапускаю веб-интерфейс"
        systemctl --user restart lan-vpn-proxy-web.service
    fi
done
echo "→ green: $(git log --oneline -1)"

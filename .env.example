# Настройки lan-vpn-proxy. Рабочая копия — .env (права 600: там ключ подписки).
# Значения со спецсимволами (&, #, $) берите в одинарные кавычки.
# После изменения: ./gen_config.py && docker compose up -d --force-recreate

# Подписка: URL от провайдера или одна ссылка vless://, vmess://, trojan://, ss://
SUBSCRIPTION=''
# Сервер из подписки: номер из ./gen_config.py --list или часть названия; пусто — первый
SERVER=
# User-Agent для загрузки подписки: от него зависит формат, который отдаёт провайдер
SUBSCRIPTION_USER_AGENT=v2rayN/7.13.8

# Адрес, на котором слушает прокси. 0.0.0.0 — для устройств в локальной сети, но БЕЗ пароля
BIND_ADDR=127.0.0.1
SOCKS_PORT=1080
# Этот же порт proxy-watch.sh прописывает в системный прокси GNOME
HTTP_PORT=3128

# Порт веб-интерфейса: http://127.0.0.1:WEB_PORT (слушает только этот адрес)
WEB_PORT=8765

# От чьего имени работает Xray в контейнере (должен читать xray/config.json)
PUID=1000
PGID=1000
